# Environment configuration for ShortVibe Backend

# Server port
PORT=3000

# PostgreSQL connection string for Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://shortvibe_user:shortvibe_password@localhost:5432/shortvibe_db?schema=public"

# Node environment (development, production, test)
NODE_ENV=development

# JWT Authentication
JWT_SECRET="your_jwt_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="7d"

# Allowed CORS Origins (comma separated or * for development)
CORS_ORIGIN="*"
