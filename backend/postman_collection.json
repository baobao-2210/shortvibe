{
  "info": {
    "name": "ShortVibe Backend API",
    "description": "Collection of all REST API endpoints for ShortVibe Short Video Application",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
      
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"test_creator\",\n  \"email\": \"creator@shortvibe.app\",\n  \"password\": \"ShortVibe@2026!\",\n  \"displayName\": \"Test Creator\",\n  \"bio\": \"Hello ShortVibe!\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.accessToken) {",
                  "    pm.collectionVariables.set('token', jsonData.accessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"alice_walker\",\n  \"password\": \"ShortVibe@2026!\"\n}"
            }
          }
        },
        {
          "name": "Get Me (Current User)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/users/11111111-1111-4111-a111-111111111111", "host": ["{{baseUrl}}"], "path": ["users", "11111111-1111-4111-a111-111111111111"] }
          }
        },
        {
          "name": "Update Profile (me)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/users/me", "host": ["{{baseUrl}}"], "path": ["users", "me"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Alice The Explorer\",\n  \"bio\": \"Living life to the fullest 🌟\"\n}"
            }
          }
        },
        {
          "name": "Get User Videos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/users/11111111-1111-4111-a111-111111111111/videos?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["users", "11111111-1111-4111-a111-111111111111", "videos"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "10"}] }
          }
        },
        {
          "name": "Get User Followers",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/11111111-1111-4111-a111-111111111111/followers", "host": ["{{baseUrl}}"], "path": ["users", "11111111-1111-4111-a111-111111111111", "followers"] }
          }
        },
        {
          "name": "Get User Following",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/users/11111111-1111-4111-a111-111111111111/following", "host": ["{{baseUrl}}"], "path": ["users", "11111111-1111-4111-a111-111111111111", "following"] }
          }
        }
      ]
    },
    {
      "name": "Videos",
      "item": [
        {
          "name": "Get Video Feed",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/videos?page=1&limit=10", "host": ["{{baseUrl}}"], "path": ["videos"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "10"}] }
          }
        },
        {
          "name": "Get Video Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/videos/aaaaaaa3-3333-4aaa-aaaa-333333333333", "host": ["{{baseUrl}}"], "path": ["videos", "aaaaaaa3-3333-4aaa-aaaa-333333333333"] }
          }
        },
        {
          "name": "Create Video",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/videos", "host": ["{{baseUrl}}"], "path": ["videos"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caption\": \"My first video on ShortVibe! #fun\",\n  \"videoUrl\": \"https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerFun.mp4\",\n  \"thumbnailUrl\": \"https://images.unsplash.com/photo-1461749280684-dccba630e2f6?w=600\",\n  \"durationSeconds\": 30,\n  \"visibility\": \"PUBLIC\"\n}"
            }
          }
        },
        {
          "name": "Update Video",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/videos/aaaaaaa1-1111-4aaa-aaaa-111111111111", "host": ["{{baseUrl}}"], "path": ["videos", "aaaaaaa1-1111-4aaa-aaaa-111111111111"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caption\": \"Updated video caption\"\n}"
            }
          }
        },
        {
          "name": "Delete Video",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/videos/aaaaaaa1-1111-4aaa-aaaa-111111111111", "host": ["{{baseUrl}}"], "path": ["videos", "aaaaaaa1-1111-4aaa-aaaa-111111111111"] }
          }
        }
      ]
    },
    {
      "name": "Likes",
      "item": [
        {
          "name": "Like Video",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/videos/aaaaaaa3-3333-4aaa-aaaa-333333333333/likes", "host": ["{{baseUrl}}"], "path": ["videos", "aaaaaaa3-3333-4aaa-aaaa-333333333333", "likes"] }
          }
        },
        {
          "name": "Unlike Video",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/videos/aaaaaaa3-3333-4aaa-aaaa-333333333333/likes", "host": ["{{baseUrl}}"], "path": ["videos", "aaaaaaa3-3333-4aaa-aaaa-333333333333", "likes"] }
          }
        },
        {
          "name": "Get Like Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/videos/aaaaaaa3-3333-4aaa-aaaa-333333333333/likes", "host": ["{{baseUrl}}"], "path": ["videos", "aaaaaaa3-3333-4aaa-aaaa-333333333333", "likes"] }
          }
        }
      ]
    },
    {
      "name": "Comments",
      "item": [
        {
          "name": "Get Comments",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/videos/aaaaaaa3-3333-4aaa-aaaa-333333333333/comments?page=1&limit=20", "host": ["{{baseUrl}}"], "path": ["videos", "aaaaaaa3-3333-4aaa-aaaa-333333333333", "comments"], "query": [{"key": "page", "value": "1"}, {"key": "limit", "value": "20"}] }
          }
        },
        {
          "name": "Create Comment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/videos/aaaaaaa3-3333-4aaa-aaaa-333333333333/comments", "host": ["{{baseUrl}}"], "path": ["videos", "aaaaaaa3-3333-4aaa-aaaa-333333333333", "comments"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Great video! Really enjoyed watching.\"\n}"
            }
          }
        },
        {
          "name": "Update Comment",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/comments/c1111111-1111-4111-a111-111111111111", "host": ["{{baseUrl}}"], "path": ["comments", "c1111111-1111-4111-a111-111111111111"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"content\": \"Updated comment content!\"\n}"
            }
          }
        },
        {
          "name": "Delete Comment",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/comments/c1111111-1111-4111-a111-111111111111", "host": ["{{baseUrl}}"], "path": ["comments", "c1111111-1111-4111-a111-111111111111"] }
          }
        }
      ]
    },
    {
      "name": "Follows",
      "item": [
        {
          "name": "Follow User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/users/22222222-2222-4222-a222-222222222222/follow", "host": ["{{baseUrl}}"], "path": ["users", "22222222-2222-4222-a222-222222222222", "follow"] }
          }
        },
        {
          "name": "Unfollow User",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/users/22222222-2222-4222-a222-222222222222/follow", "host": ["{{baseUrl}}"], "path": ["users", "22222222-2222-4222-a222-222222222222", "follow"] }
          }
        },
        {
          "name": "Get Follow Status",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/users/22222222-2222-4222-a222-222222222222/follow-status", "host": ["{{baseUrl}}"], "path": ["users", "22222222-2222-4222-a222-222222222222", "follow-status"] }
          }
        }
      ]
    }
  ]
}
